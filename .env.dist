# Copy to .env and replace every "changeme" (e.g. openssl rand -hex 24)
# Use only [A-Za-z0-9]: values are substituted via sed (# delimiter) and into SQL in entrypoints.

# Ubuntu base of all images: 26.04 (latest release) or 24.04 (previous LTS)
UBUNTU_VERSION=26.04

# PostgreSQL superuser (used by bareos-db and for initial DB creation by bareos-dir)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=changeme

# Bareos catalog DB user password (see DB_USER below)
DB_PASSWORD=changeme

# Director console (bconsole); empty = random, see data/bareos/config/director/bconsole.conf
BAREOS_DIR_PASSWORD=

# Director <-> Storage daemon
BAREOS_SD_PASSWORD=changeme

# Director <-> File daemon (client)
BAREOS_FD_PASSWORD=changeme

# WebUI admin console (login: admin)
BAREOS_WEBUI_PASSWORD=changeme

# Catalog DB (defaults: bareos)
DB_NAME=bareos
DB_USER=bareos

# Mail notifications (applied once, on first director init)
ADMIN_MAIL=your@mail.address
SENDER_MAIL=
SMTP_HELO_NAME=bareos.local
# Optional smarthost for smtpd relay, e.g. smtp.example.com:587 (465 = implicit TLS)
SMTP_SMARTHOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional Slack/Telegram notifications (true disables email)
WEBHOOK_NOTIFICATION=false
WEBHOOK_TYPE=slack
WEBHOOK_URL=
WEBHOOK_CHAT_ID=

# REST API JWT signing key; empty = new random key on every start (tokens expire on restart)
BAREOS_API_SECRET=

# Published ports bind address (127.0.0.1 = local only)
# Set SD_BIND=0.0.0.0 when file daemons on other hosts back up to this storage
SD_BIND=127.0.0.1
# Web UI is plain HTTP: publish it via an HTTPS reverse proxy or VPN
WEBUI_BIND=127.0.0.1
